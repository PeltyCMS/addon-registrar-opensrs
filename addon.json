{
  "id": "registrar-opensrs",
  "name": "OpenSRS",
  "version": "0.1.0",
  "kind": "registrar",
  "engine": "wasm",
  "provides": "opensrs",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.registrar.opensrs",
  "author": "MythicalSystems",
  "permissions": [
    "domains.manage",
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "horizon.opensrs.net",
      "rr-n1-tor.opensrs.net",
      "$setting:api_base"
    ],
    "secrets": []
  },
  "settings": [
    {
      "key": "username",
      "label": "addons.registrar.setting.username",
      "kind": "text",
      "required": true
    },
    {
      "key": "api_key",
      "label": "addons.registrar.setting.api_key",
      "kind": "secret",
      "required": true
    },
    {
      "key": "reg_username",
      "label": "addons.registrar.setting.reg_username",
      "kind": "text",
      "required": false
    },
    {
      "key": "reg_password",
      "label": "addons.registrar.setting.reg_password",
      "kind": "secret",
      "required": false
    },
    {
      "key": "test_mode",
      "label": "addons.registrar.setting.test_mode",
      "kind": "bool",
      "required": false,
      "default": false
    },
    {
      "key": "api_base",
      "label": "addons.registrar.setting.api_base",
      "kind": "text",
      "required": false
    }
  ]
}
